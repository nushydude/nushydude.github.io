---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/blog/PostCard.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
---

<BaseLayout title="Blog" description="Writing on engineering, product thinking, and side projects.">
  <section class="mx-auto max-w-6xl px-6 pb-10 pt-16 md:pb-14 md:pt-24">
    <div class="surface-card-strong rounded-[2rem] p-8 md:p-10">
      <p class="section-label">Blog</p>
      <h1 class="mt-4 text-5xl font-semibold tracking-[-0.06em] text-white md:text-7xl md:leading-[0.96]">Writing on engineering, product work, and the kinds of side projects worth keeping</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-300 md:text-xl">
        A simple MDX-backed archive for notes that are technical enough to be useful, but still grounded in product and
        real-world trade-offs.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-8 md:py-10">
    <div class="grid gap-6 lg:grid-cols-2">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
