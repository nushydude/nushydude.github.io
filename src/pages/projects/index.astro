---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/projects/ProjectCard.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => {
  const flagshipDelta = Number(b.data.flagship ?? false) - Number(a.data.flagship ?? false);
  if (flagshipDelta !== 0) return flagshipDelta;
  const sortDelta = (b.data.sortOrder ?? 0) - (a.data.sortOrder ?? 0);
  if (sortDelta !== 0) return sortDelta;
  return b.data.yearStart - a.data.yearStart;
});

const flagshipProject = projects.find((project) => project.data.flagship) ?? projects[0];
const remainingProjects = projects.filter((project) => project.id !== flagshipProject?.id);
---

<BaseLayout title="Projects" description="Selected apps, products, and experiments by Anusha Dharmasena.">
  <section class="mx-auto max-w-6xl px-6 pb-10 pt-16 md:pb-14 md:pt-24">
    <div class="surface-card-strong rounded-[2rem] p-8 md:p-10">
      <p class="section-label">Projects</p>
      <h1 class="mt-4 text-5xl font-semibold tracking-[-0.06em] text-white md:text-7xl md:leading-[0.96]">Fiscava first, then the other products and tools around it</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-300 md:text-xl">
        This collection is centred on software I have actually kept shaping. Fiscava is the flagship app, with the rest of the portfolio showing the adjacent systems, utilities, and experiments that inform how I build.
      </p>
    </div>
  </section>

  {flagshipProject && (
    <section class="mx-auto max-w-6xl px-6 py-8 md:py-10">
      <div class="surface-card-strong overflow-hidden rounded-[2rem] border border-sky-300/18 p-8 md:p-10">
        <div class="grid gap-8 lg:grid-cols-[1fr_1.08fr] lg:items-center">
          <div>
            <p class="section-label">Flagship app</p>
            <h2 class="mt-4 text-3xl font-semibold tracking-[-0.05em] text-white md:text-5xl">{flagshipProject.data.title}</h2>
            <p class="mt-6 max-w-2xl text-base leading-8 text-slate-300 md:text-lg">{flagshipProject.data.summary}</p>
            <div class="mt-6 flex flex-wrap gap-3 text-sm text-slate-300">
              <span class="pill">{flagshipProject.data.yearStart}–present</span>
              <span class="pill">Role: {flagshipProject.data.role}</span>
              {flagshipProject.data.stack.map((item) => <span class="pill">{item}</span>)}
            </div>
            <div class="mt-8 flex flex-wrap gap-4">
              <a href={`/projects/${flagshipProject.id}/`} class="button-primary">Read the Fiscava page</a>
              {flagshipProject.data.links?.live && (
                <a href={flagshipProject.data.links.live} class="button-secondary" target="_blank" rel="noreferrer">Visit fiscava.app</a>
              )}
            </div>
          </div>
          <a href={`/projects/${flagshipProject.id}/`} class="group block overflow-hidden rounded-[1.5rem] border border-white/10 bg-[radial-gradient(circle_at_top_left,_rgba(125,211,252,0.16),_transparent_45%),linear-gradient(135deg,rgba(15,23,42,0.96),rgba(15,23,42,0.72))] p-4">
            <img
              src={flagshipProject.data.heroImage?.src ?? flagshipProject.data.coverImage}
              alt={flagshipProject.data.heroImage?.alt ?? `Visual preview for ${flagshipProject.data.title}`}
              class="w-full rounded-[1.2rem] border border-white/10 transition duration-300 group-hover:scale-[1.015] group-hover:border-sky-300/25"
            />
          </a>
        </div>
      </div>
    </section>
  )}

  <section class="mx-auto max-w-6xl px-6 py-8 md:py-10">
    <div class="mb-8 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="section-label">More projects</p>
        <h2 class="mt-4 text-3xl font-semibold tracking-[-0.05em] text-white md:text-5xl">The supporting products, tools, and experiments</h2>
      </div>
    </div>
    <div class="grid gap-6 lg:grid-cols-2">
      {remainingProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</BaseLayout>
