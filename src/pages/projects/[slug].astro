---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ScreenshotCarousel from '../../components/projects/ScreenshotCarousel.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const years = project.data.yearEnd
  ? `${project.data.yearStart}–${project.data.yearEnd}`
  : `${project.data.yearStart}–present`;
const projectLinks = project.data.links
  ? [
      project.data.links.live ? { href: project.data.links.live, label: 'Live site' } : null,
      project.data.links.download ? { href: project.data.links.download, label: 'Download for Windows' } : null,
      project.data.links.repo ? { href: project.data.links.repo, label: 'Repository' } : null,
      project.data.links.caseStudy ? { href: project.data.links.caseStudy, label: 'Case study' } : null,
      project.data.links.appStore ? { href: project.data.links.appStore, label: 'App store' } : null,
    ].filter(Boolean)
  : [];
const heroImage = project.data.heroImage ?? (project.data.coverImage
  ? {
      src: project.data.coverImage,
      alt: `Visual preview for ${project.data.title}`,
    }
  : null);
const ogCandidate = project.data.ogImage ?? project.data.heroImage?.src ?? project.data.coverImage;
const ogImage = ogCandidate && !ogCandidate.endsWith('.svg') ? ogCandidate : undefined;

// Build a de-duplicated screenshot list for the carousel (hero first, then gallery).
const screenshotMap = new Map<string, { src: string; alt: string; caption?: string }>();
if (heroImage) {
  screenshotMap.set(heroImage.src, { src: heroImage.src, alt: heroImage.alt });
}
for (const image of project.data.gallery) {
  const existing = screenshotMap.get(image.src);
  if (existing) {
    if (!existing.caption && image.caption) existing.caption = image.caption;
  } else {
    screenshotMap.set(image.src, { src: image.src, alt: image.alt, caption: image.caption });
  }
}
const screenshots = [...screenshotMap.values()];
---

<BaseLayout title={project.data.title} description={project.data.summary} image={ogImage} type="article">
  <article class="mx-auto max-w-5xl px-6 pb-10 pt-16 md:pb-14 md:pt-24">
    <a href="/projects/" class="mb-6 inline-flex text-sm font-medium text-sky-300 hover:text-sky-200">← Back to projects</a>

    <div class={`rounded-[2rem] p-8 md:p-10 ${project.data.flagship ? 'surface-card-strong border border-sky-300/18' : 'surface-card-strong'}`}>
      <p class="section-label">{project.data.flagship ? 'Flagship app' : project.data.status}</p>
      <h1 class="mt-4 text-5xl font-semibold tracking-[-0.06em] text-white md:text-7xl md:leading-[0.96]">{project.data.title}</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-300 md:text-xl">{project.data.summary}</p>
      <div class="mt-8 flex flex-wrap gap-3 text-sm text-slate-300">
        <span class="pill">{years}</span>
        <span class="pill">Role: {project.data.role}</span>
        {project.data.stack.map((item) => <span class="pill">{item}</span>)}
      </div>
      {projectLinks.length > 0 && (
        <div class="mt-8 flex flex-wrap gap-3">
          {projectLinks.map((link) => (
            <a href={link.href} class="button-secondary !px-5 !py-2.5 text-sm" target="_blank" rel="noreferrer">{link.label}</a>
          ))}
        </div>
      )}
    </div>

    <div class="surface-card mt-8 overflow-hidden rounded-[2rem]">
      {screenshots.length > 0 ? (
        <section class="border-b border-white/10 px-4 py-6 md:px-8 md:py-8">
          <div class="mb-5 px-2 md:px-0">
            <p class="section-label">App visuals</p>
            <h2 class="mt-4 text-2xl font-semibold tracking-[-0.04em] text-white md:text-3xl">Screens and product views</h2>
            <p class="mt-2 text-sm text-slate-400">Swipe or use the arrows — click any screen to view it full size.</p>
          </div>
          <ScreenshotCarousel images={screenshots} />
        </section>
      ) : (
        <div class="border-b border-white/10 bg-[radial-gradient(circle_at_top_left,_rgba(125,211,252,0.14),_transparent_40%),linear-gradient(135deg,rgba(15,23,42,0.96),rgba(15,23,42,0.72))] p-8 md:p-10">
          <p class="text-xs font-semibold uppercase tracking-[0.24em] text-sky-300">Visual placeholder</p>
          <h2 class="mt-5 text-3xl font-semibold tracking-[-0.04em] text-white">Screenshots coming soon for {project.data.title}</h2>
          <p class="mt-4 max-w-2xl text-sm leading-7 text-slate-300">Product screens for this project will appear here.</p>
        </div>
      )}

      <div class="p-8 md:p-10">
        <div class="prose-shell max-w-none">
          <Content />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
