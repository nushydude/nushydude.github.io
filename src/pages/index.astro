---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/projects/ProjectCard.astro';
import PostCard from '../components/blog/PostCard.astro';

const featuredProjects = (await getCollection('projects', ({ data }) => !data.draft && data.featured)).sort((a, b) => {
  const flagshipDelta = Number(b.data.flagship ?? false) - Number(a.data.flagship ?? false);
  if (flagshipDelta !== 0) return flagshipDelta;
  const sortDelta = (b.data.sortOrder ?? 0) - (a.data.sortOrder ?? 0);
  if (sortDelta !== 0) return sortDelta;
  return b.data.yearStart - a.data.yearStart;
});

const flagshipProject = featuredProjects.find((project) => project.data.flagship) ?? featuredProjects[0];
const supportingProjects = featuredProjects.filter((project) => project.id !== flagshipProject?.id).slice(0, 3);

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <section class="mx-auto max-w-6xl px-6 pb-10 pt-16 md:pb-14 md:pt-24">
    <div class="grid gap-8 md:grid-cols-[1.35fr_0.95fr] md:items-stretch">
      <div class="surface-card-strong rounded-[2rem] p-8 md:p-10">
        <p class="section-label">Tech lead · product-minded builder</p>
        <h1 class="mt-6 max-w-4xl text-5xl font-semibold tracking-[-0.07em] text-white md:text-7xl md:leading-[0.95]">
          Building practical digital products, with Fiscava leading the way.
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300 md:text-xl">
          I am Anusha Dharmasena — a Melbourne-based tech lead who enjoys turning fuzzy ideas into useful products.
          My personal work is anchored by Fiscava, alongside household tooling, small utilities, and client delivery work that keeps me sharp.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/projects/fiscava/" class="button-primary">See Fiscava</a>
          <a href="/projects" class="button-secondary">View all projects</a>
          <a href="/blog" class="button-secondary">Read the blog</a>
        </div>
        <div class="mt-10 grid gap-3 sm:grid-cols-3">
          <div class="surface-card rounded-2xl p-4">
            <p class="text-xs uppercase tracking-[0.22em] text-slate-400">Flagship app</p>
            <p class="mt-3 text-sm leading-7 text-slate-200">Fiscava — a broader personal finance product built around clarity, not just transaction capture.</p>
          </div>
          <div class="surface-card rounded-2xl p-4">
            <p class="text-xs uppercase tracking-[0.22em] text-slate-400">Client work</p>
            <p class="mt-3 text-sm leading-7 text-slate-200">Client delivery work that keeps my engineering judgement sharp.</p>
          </div>
          <div class="surface-card rounded-2xl p-4">
            <p class="text-xs uppercase tracking-[0.22em] text-slate-400">Bias</p>
            <p class="mt-3 text-sm leading-7 text-slate-200">Useful systems, clear trade-offs, and products that survive real use.</p>
          </div>
        </div>
      </div>

      <aside class="surface-card rounded-[2rem] p-6 md:p-8">
        <div class="rounded-[1.5rem] border border-white/10 bg-[radial-gradient(circle_at_top,_rgba(125,211,252,0.12),_transparent_58%),linear-gradient(180deg,rgba(15,23,42,0.98),rgba(15,23,42,0.78))] px-6 py-8 text-center">
          <img src="/images/profile/profile.jpg" alt="Photo of Anusha Dharmasena" width="200" height="200" decoding="async" class="mx-auto h-44 w-44 rounded-full border border-white/10 object-cover shadow-[0_24px_60px_-34px_rgba(2,6,23,0.95)] md:h-48 md:w-48" />
          <div class="mt-5 flex flex-wrap justify-center gap-2">
            <span class="pill text-xs">Melbourne</span>
            <span class="pill text-xs">Tech lead</span>
            <span class="pill text-xs">Product-minded builder</span>
          </div>
        </div>
        <div class="mt-6">
          <p class="section-label">Current focus</p>
          <ul class="mt-5 space-y-4 text-sm leading-7 text-slate-300">
            <li class="surface-card rounded-2xl p-4">Leading digital product delivery at David Jones.</li>
            <li class="surface-card rounded-2xl p-4">Growing Fiscava into the clearest personal finance product in my portfolio.</li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  {flagshipProject && (
    <section class="mx-auto max-w-6xl px-6 py-10 md:py-12">
      <div class="surface-card-strong overflow-hidden rounded-[2rem] border border-sky-300/18 p-8 md:p-10">
        <div class="grid gap-8 lg:grid-cols-[1fr_1.08fr] lg:items-center">
          <div>
            <p class="section-label">Flagship app</p>
            <h2 class="mt-4 text-3xl font-semibold tracking-[-0.05em] text-white md:text-5xl">Fiscava is the personal product I want the site to orbit around.</h2>
            <p class="mt-6 max-w-2xl text-base leading-8 text-slate-300 md:text-lg">{flagshipProject.data.summary}</p>
            <div class="mt-6 flex flex-wrap gap-3 text-sm text-slate-300">
              <span class="pill">{flagshipProject.data.yearStart}–present</span>
              <span class="pill">Role: {flagshipProject.data.role}</span>
              {flagshipProject.data.stack.slice(0, 3).map((item) => <span class="pill">{item}</span>)}
            </div>
            <div class="mt-8 flex flex-wrap gap-4">
              <a href={`/projects/${flagshipProject.id}/`} class="button-primary">Open the Fiscava case study</a>
              {flagshipProject.data.links?.live && (
                <a href={flagshipProject.data.links.live} class="button-secondary" target="_blank" rel="noreferrer">Visit fiscava.app</a>
              )}
            </div>
          </div>
          <a href={`/projects/${flagshipProject.id}/`} class="group block overflow-hidden rounded-[1.5rem] border border-white/10 bg-[radial-gradient(circle_at_top_left,_rgba(125,211,252,0.16),_transparent_45%),linear-gradient(135deg,rgba(15,23,42,0.96),rgba(15,23,42,0.72))] p-4">
            <img
              src={flagshipProject.data.heroImage?.src ?? flagshipProject.data.coverImage}
              alt={flagshipProject.data.heroImage?.alt ?? `Visual preview for ${flagshipProject.data.title}`}
              loading="lazy"
              decoding="async"
              class="w-full rounded-[1.2rem] border border-white/10 transition duration-300 group-hover:scale-[1.015] group-hover:border-sky-300/25"
            />
          </a>
        </div>
      </div>
    </section>
  )}

  <section class="mx-auto max-w-6xl px-6 py-10 md:py-12">
    <div class="mb-8 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="section-label">Supporting projects</p>
        <h2 class="mt-4 text-3xl font-semibold tracking-[-0.05em] text-white md:text-5xl">Other apps and tools I have kept improving</h2>
      </div>
      <a href="/projects" class="text-sm text-sky-300 hover:text-sky-200">See all projects →</a>
    </div>
    <div class="grid gap-6 lg:grid-cols-3">
      {supportingProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-10 md:py-12">
    <div class="surface-card rounded-[2rem] p-8 md:p-10">
      <div class="mb-8 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="section-label">Recent writing</p>
          <h2 class="mt-4 text-3xl font-semibold tracking-[-0.05em] text-white md:text-5xl">Notes on engineering, product thinking, and side projects</h2>
        </div>
        <a href="/blog" class="text-sm text-sky-300 hover:text-sky-200">Browse the archive →</a>
      </div>
      <div class="grid gap-6 lg:grid-cols-3">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-10 md:py-12">
    <div class="grid gap-6 md:grid-cols-[1.1fr_0.9fr]">
      <div class="surface-card-strong rounded-[2rem] p-8 md:p-10">
        <p class="section-label">Experience</p>
        <h2 class="mt-4 text-3xl font-semibold tracking-[-0.05em] text-white md:text-5xl">A cross-country path through engineering and product work</h2>
        <p class="mt-6 max-w-2xl text-base leading-8 text-slate-300 md:text-lg">
          My work has moved from Sri Lanka to Japan to Australia, across deeply technical engineering, product delivery,
          and team leadership. I tend to do my best work where software has to become useful, durable, and understandable.
        </p>
      </div>
      <div class="surface-card rounded-[2rem] p-8">
        <ul class="space-y-4 text-sm leading-7 text-slate-300">
          <li class="surface-card rounded-2xl p-4"><span class="font-semibold text-white">Sri Lanka:</span> early engineering foundations and a global outlook.</li>
          <li class="surface-card rounded-2xl p-4"><span class="font-semibold text-white">Japan:</span> Canon work on printer-driver, PDF, and SVG-heavy systems.</li>
          <li class="surface-card rounded-2xl p-4"><span class="font-semibold text-white">Australia:</span> broader product, front-end, and leadership roles.</li>
        </ul>
        <a href="/about" class="mt-6 inline-flex text-sm font-medium text-sky-300 hover:text-sky-200">Read the longer version →</a>
      </div>
    </div>
  </section>
</BaseLayout>
