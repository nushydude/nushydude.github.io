---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Now" description="Current focus areas for Anusha Dharmasena.">
  <section class="mx-auto max-w-5xl px-6 pb-10 pt-16 md:pb-14 md:pt-24">
    <div class="surface-card-strong rounded-[2rem] p-8 md:p-10">
      <p class="section-label">Now</p>
      <h1 class="mt-4 text-5xl font-semibold tracking-[-0.06em] text-white md:text-7xl md:leading-[0.96]">What I am focused on right now</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-300 md:text-xl">
        A short page for current themes rather than a full public changelog. This is the stuff that has my attention at the moment.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-8 md:py-10">
    <div class="grid gap-6 md:grid-cols-3">
      <div class="surface-card rounded-[2rem] p-6">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-sky-300">Work</p>
        <p class="mt-4 text-sm leading-7 text-slate-300">Leading digital delivery work and trying to keep execution quality high without making the process heavier than it needs to be.</p>
      </div>
      <div class="surface-card rounded-[2rem] p-6">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-sky-300">Side projects</p>
        <p class="mt-4 text-sm leading-7 text-slate-300">Improving the shape and quality of personal products, especially where the idea is strong but the presentation still needs work.</p>
      </div>
      <div class="surface-card rounded-[2rem] p-6">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-sky-300">Theme</p>
        <p class="mt-4 text-sm leading-7 text-slate-300">Trying to stay ambitious without building systems that become harder to understand every month.</p>
      </div>
    </div>
  </section>
</BaseLayout>
