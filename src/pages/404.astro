---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" description="Page not found.">
  <section class="mx-auto max-w-3xl px-6 py-28 text-center">
    <p class="text-sm font-semibold uppercase tracking-[0.24em] text-sky-300">404</p>
    <h1 class="mt-3 text-5xl font-semibold tracking-tight text-white">That page is missing</h1>
    <p class="mt-6 text-lg leading-8 text-slate-300">The route may have changed during the rebuild. Try the projects or blog index instead.</p>
    <div class="mt-8 flex justify-center gap-4">
      <a href="/projects" class="rounded-full bg-sky-400 px-6 py-3 font-medium text-slate-950 transition hover:bg-sky-300">Projects</a>
      <a href="/blog" class="rounded-full border border-white/15 px-6 py-3 font-medium text-white transition hover:border-sky-300 hover:text-sky-300">Blog</a>
    </div>
  </section>
</BaseLayout>
