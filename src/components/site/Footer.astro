---
import { site } from '../../lib/site';
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-white/10 bg-slate-950/75">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-12 md:grid-cols-[1.4fr_0.8fr_0.8fr]">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sky-300">Anusha Dharmasena</p>
      <p class="mt-3 max-w-xl text-sm leading-7 text-slate-400">
        Personal site centred on products, writing, and practical engineering work — built and maintained in Astro.
      </p>
    </div>

    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Explore</p>
      <ul class="mt-4 space-y-2 text-sm text-slate-400">
        {site.nav
          .filter((item) => item.href !== '/')
          .concat(site.secondaryNav)
          .map((item) => (
            <li><a class="transition hover:text-sky-300" href={item.href}>{item.label}</a></li>
          ))}
      </ul>
    </div>

    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">Connect</p>
      <ul class="mt-4 space-y-2 text-sm text-slate-400">
        <li><a class="transition hover:text-sky-300" href={site.social.email}>{site.email}</a></li>
        <li><a class="transition hover:text-sky-300" href={site.social.linkedin} target="_blank" rel="noreferrer">LinkedIn</a></li>
        <li><a class="transition hover:text-sky-300" href={site.social.github} target="_blank" rel="noreferrer">GitHub</a></li>
      </ul>
    </div>
  </div>

  <div class="mx-auto flex max-w-6xl flex-col gap-2 px-6 pb-10 text-sm text-slate-500 md:flex-row md:items-center md:justify-between">
    <p>© {year} Anusha Dharmasena.</p>
    <p>Built with Astro, content collections, and a static-first workflow.</p>
  </div>
</footer>
