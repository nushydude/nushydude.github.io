---
import { site } from '../../lib/site';
const pathname = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-slate-950/70 backdrop-blur-xl">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-4">
    <a href="/" class="flex items-center gap-3 text-sm font-semibold tracking-[0.18em] text-white uppercase">
      <span class="inline-flex h-2.5 w-2.5 rounded-full bg-sky-300 shadow-[0_0_20px_rgba(125,211,252,0.95)]"></span>
      <span>Anusha Dharmasena</span>
    </a>
    <nav class="hidden items-center gap-2 rounded-full border border-white/10 bg-white/[0.04] p-1 text-sm text-slate-300 md:flex">
      {site.nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'rounded-full px-4 py-2 transition',
            pathname === item.href
              ? 'bg-white/10 text-white shadow-[0_0_0_1px_rgba(255,255,255,0.06)]'
              : 'hover:text-sky-300',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>
