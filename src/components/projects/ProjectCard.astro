---
interface Props {
  project: {
    id: string;
    data: {
      title: string;
      summary: string;
      status: string;
      role: string;
      stack: string[];
      yearStart: number;
      yearEnd?: number;
      coverImage?: string;
      flagship?: boolean;
    };
  };
}

const { project } = Astro.props;
const years = project.data.yearEnd
  ? `${project.data.yearStart}–${project.data.yearEnd}`
  : `${project.data.yearStart}–present`;
---

<a
  href={`/projects/${project.id}/`}
  class={`group block h-full overflow-hidden rounded-[1.75rem] border transition duration-200 hover:-translate-y-1 hover:border-sky-300/35 hover:shadow-[0_28px_70px_-38px_rgba(56,189,248,0.45)] ${
    project.data.flagship
      ? 'border-sky-300/28 bg-[linear-gradient(180deg,rgba(15,23,42,0.96),rgba(15,23,42,0.82))] shadow-[0_0_0_1px_rgba(125,211,252,0.1),0_20px_65px_-38px_rgba(56,189,248,0.4)]'
      : 'surface-card'
  }`}
>
  {project.data.coverImage && (
    <div class="overflow-hidden border-b border-white/10 bg-[linear-gradient(135deg,rgba(15,23,42,0.95),rgba(15,23,42,0.72))] p-3">
      <img
        src={project.data.coverImage}
        alt={`Visual preview for ${project.data.title}`}
        class="w-full rounded-[1.1rem] border border-white/10 transition duration-300 group-hover:scale-[1.015] group-hover:border-sky-300/25"
      />
    </div>
  )}
  <div class="p-6 md:p-7">
    <div class="mb-5 flex items-start justify-between gap-4">
      <div>
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.24em] text-sky-300">
          {project.data.flagship ? 'flagship app' : project.data.status}
        </p>
        <h3 class="inline-flex items-center gap-2 text-2xl font-semibold tracking-[-0.04em] text-white md:text-[1.8rem]">
          {project.data.title}
          <span class="text-slate-500 transition group-hover:translate-x-1 group-hover:text-sky-300">→</span>
        </h3>
      </div>
      <span class="pill whitespace-nowrap text-xs">{years}</span>
    </div>
    <p class="mb-5 text-sm leading-7 text-slate-300">{project.data.summary}</p>
    <p class="mb-5 text-sm text-slate-400">Role: {project.data.role}</p>
    <ul class="flex flex-wrap gap-2">
      {project.data.stack.map((item) => (
        <li class="pill text-xs">{item}</li>
      ))}
    </ul>
  </div>
</a>
