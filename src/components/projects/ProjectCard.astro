---
interface Props {
  project: {
    id: string;
    data: {
      title: string;
      summary: string;
      status: string;
      role: string;
      stack: string[];
      yearStart: number;
      yearEnd?: number;
      coverImage?: string;
    };
  };
}

const { project } = Astro.props;
const years = project.data.yearEnd
  ? `${project.data.yearStart}–${project.data.yearEnd}`
  : `${project.data.yearStart}–present`;
---

<article class="surface-card group overflow-hidden rounded-[1.75rem]">
  {project.data.coverImage && (
    <a href={`/projects/${project.id}/`} class="block border-b border-white/10 bg-[linear-gradient(135deg,rgba(15,23,42,0.95),rgba(15,23,42,0.72))] p-3">
      <img src={project.data.coverImage} alt={`Visual preview for ${project.data.title}`} class="w-full rounded-[1.1rem] border border-white/10" />
    </a>
  )}
  <div class="p-6 md:p-7">
    <div class="mb-5 flex items-start justify-between gap-4">
      <div>
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.24em] text-sky-300">{project.data.status}</p>
        <h3 class="text-2xl font-semibold tracking-[-0.04em] text-white md:text-[1.8rem]">
          <a href={`/projects/${project.id}/`} class="inline-flex items-center gap-2 hover:text-sky-300">
            {project.data.title}
            <span class="text-slate-500 transition group-hover:translate-x-1 group-hover:text-sky-300">→</span>
          </a>
        </h3>
      </div>
      <span class="pill whitespace-nowrap text-xs">{years}</span>
    </div>
    <p class="mb-5 text-sm leading-7 text-slate-300">{project.data.summary}</p>
    <p class="mb-5 text-sm text-slate-400">Role: {project.data.role}</p>
    <ul class="flex flex-wrap gap-2">
      {project.data.stack.map((item) => (
        <li class="pill text-xs">{item}</li>
      ))}
    </ul>
  </div>
</article>
