---
interface Image {
  src: string;
  alt: string;
  caption?: string;
}

interface Props {
  images: Image[];
}

const { images } = Astro.props;
const first = images[0];
---

{images.length > 0 && (
  <div class="screenshot-carousel" data-carousel>
    <div class="carousel-viewport">
      <div class="carousel-track" data-track>
        {images.map((image, i) => (
          <figure class="carousel-slide" data-slide={i} data-caption={image.caption ?? ''}>
            <button type="button" class="carousel-frame" data-open={i} aria-label={`Enlarge: ${image.alt}`}>
              <img
                src={image.src}
                alt={image.alt}
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
              <span class="carousel-zoom" aria-hidden="true">⤢ Click to enlarge</span>
            </button>
          </figure>
        ))}
      </div>

      {images.length > 1 && (
        <>
          <button type="button" class="carousel-arrow carousel-arrow-prev" data-prev aria-label="Previous screenshot">‹</button>
          <button type="button" class="carousel-arrow carousel-arrow-next" data-next aria-label="Next screenshot">›</button>
        </>
      )}
    </div>

    <div class="carousel-meta">
      <p class="carousel-caption" data-caption-out>{first.caption}</p>
      {images.length > 1 && (
        <div class="carousel-dots" data-dots>
          {images.map((_, i) => (
            <button type="button" class="carousel-dot" data-dot={i} aria-label={`Go to screenshot ${i + 1}`}></button>
          ))}
        </div>
      )}
    </div>

    <dialog class="lightbox" data-lightbox>
      <button type="button" class="lightbox-close" data-close aria-label="Close viewer">✕</button>
      {images.length > 1 && (
        <>
          <button type="button" class="lightbox-arrow lightbox-arrow-prev" data-lb-prev aria-label="Previous">‹</button>
          <button type="button" class="lightbox-arrow lightbox-arrow-next" data-lb-next aria-label="Next">›</button>
        </>
      )}
      <figure class="lightbox-figure">
        <img class="lightbox-img" data-lb-img src="" alt="" />
        <figcaption class="lightbox-caption">
          <span data-lb-caption></span>
          <span class="lightbox-counter" data-lb-counter></span>
        </figcaption>
      </figure>
    </dialog>
  </div>
)}

<style>
  .screenshot-carousel {
    --carousel-bg: radial-gradient(circle at top left, rgba(125, 211, 252, 0.14), transparent 40%),
      linear-gradient(135deg, rgba(15, 23, 42, 0.96), rgba(15, 23, 42, 0.72));
  }

  .carousel-viewport {
    position: relative;
  }

  .carousel-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    border-radius: 1.25rem;
    background: var(--carousel-bg);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .carousel-track::-webkit-scrollbar {
    display: none;
  }

  .carousel-slide {
    flex: 0 0 100%;
    scroll-snap-align: center;
    margin: 0;
    padding: 1rem;
  }

  @media (min-width: 768px) {
    .carousel-slide {
      padding: 1.5rem;
    }
  }

  .carousel-frame {
    position: relative;
    display: block;
    width: 100%;
    cursor: zoom-in;
    border: 0;
    padding: 0;
    background: transparent;
    border-radius: 1rem;
  }

  .carousel-frame img {
    display: block;
    width: 100%;
    max-height: 70vh;
    object-fit: contain;
    border-radius: 0.85rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(2, 6, 23, 0.4);
  }

  .carousel-zoom {
    position: absolute;
    right: 0.85rem;
    bottom: 0.85rem;
    border-radius: 9999px;
    background: rgba(2, 6, 23, 0.78);
    border: 1px solid rgba(148, 163, 184, 0.28);
    padding: 0.35rem 0.7rem;
    font-size: 0.72rem;
    color: #e2e8f0;
    opacity: 0;
    transition: opacity 160ms ease;
    pointer-events: none;
  }

  .carousel-frame:hover .carousel-zoom,
  .carousel-frame:focus-visible .carousel-zoom {
    opacity: 1;
  }

  .carousel-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 2.75rem;
    height: 2.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: rgba(2, 6, 23, 0.72);
    border: 1px solid rgba(148, 163, 184, 0.28);
    color: #e2e8f0;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: background 160ms ease, border-color 160ms ease, color 160ms ease;
  }

  .carousel-arrow:hover {
    background: rgba(2, 6, 23, 0.92);
    border-color: rgba(125, 211, 252, 0.5);
    color: #7dd3fc;
  }

  .carousel-arrow-prev {
    left: 0.75rem;
  }

  .carousel-arrow-next {
    right: 0.75rem;
  }

  .carousel-meta {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    align-items: center;
    margin-top: 1.1rem;
  }

  .carousel-caption {
    min-height: 1.5rem;
    text-align: center;
    font-size: 0.875rem;
    line-height: 1.6;
    color: #94a3b8;
  }

  .carousel-dots {
    display: flex;
    gap: 0.5rem;
  }

  .carousel-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    border: 0;
    padding: 0;
    background: rgba(148, 163, 184, 0.35);
    cursor: pointer;
    transition: background 160ms ease, transform 160ms ease;
  }

  .carousel-dot[aria-current='true'] {
    background: #38bdf8;
    transform: scale(1.35);
  }

  /* Lightbox */
  .lightbox {
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
  }

  .lightbox::backdrop {
    background: rgba(2, 6, 23, 0.92);
    backdrop-filter: blur(6px);
  }

  .lightbox:not([open]) {
    display: none;
  }

  .lightbox-figure {
    margin: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 3.5rem 1rem 1.5rem;
  }

  .lightbox-img {
    max-width: 95vw;
    max-height: 82vh;
    object-fit: contain;
    border-radius: 0.75rem;
    border: 1px solid rgba(148, 163, 184, 0.25);
    box-shadow: 0 40px 120px -40px rgba(0, 0, 0, 0.9);
  }

  .lightbox-caption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    justify-content: center;
    align-items: center;
    text-align: center;
    font-size: 0.85rem;
    color: #cbd5e1;
    max-width: 70ch;
  }

  .lightbox-counter {
    color: #64748b;
    font-variant-numeric: tabular-nums;
  }

  .lightbox-close,
  .lightbox-arrow {
    position: fixed;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(148, 163, 184, 0.3);
    color: #e2e8f0;
    cursor: pointer;
    transition: background 160ms ease, border-color 160ms ease, color 160ms ease;
  }

  .lightbox-close:hover,
  .lightbox-arrow:hover {
    background: rgba(15, 23, 42, 1);
    border-color: rgba(125, 211, 252, 0.55);
    color: #7dd3fc;
  }

  .lightbox-close {
    top: 1rem;
    right: 1rem;
    width: 2.75rem;
    height: 2.75rem;
    font-size: 1.1rem;
  }

  .lightbox-arrow {
    top: 50%;
    transform: translateY(-50%);
    width: 3rem;
    height: 3rem;
    font-size: 1.8rem;
    line-height: 1;
  }

  .lightbox-arrow-prev {
    left: 1rem;
  }

  .lightbox-arrow-next {
    right: 1rem;
  }
</style>

<script>
  function initCarousel(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>('[data-track]');
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.carousel-slide'));
    const captionOut = root.querySelector<HTMLElement>('[data-caption-out]');
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const dialog = root.querySelector<HTMLDialogElement>('[data-lightbox]');
    const lbImg = root.querySelector<HTMLImageElement>('[data-lb-img]');
    const lbCaption = root.querySelector<HTMLElement>('[data-lb-caption]');
    const lbCounter = root.querySelector<HTMLElement>('[data-lb-counter]');

    if (!track || slides.length === 0) return;

    const data = slides.map((s) => {
      const img = s.querySelector('img');
      return {
        src: img?.currentSrc || img?.src || '',
        alt: img?.alt || '',
        caption: s.dataset.caption || '',
      };
    });

    let current = 0;
    let lbIndex = 0;

    const setActive = (i: number) => {
      current = (i + slides.length) % slides.length;
      if (captionOut) captionOut.textContent = data[current].caption;
      dots.forEach((d, di) => d.setAttribute('aria-current', di === current ? 'true' : 'false'));
    };

    const scrollToSlide = (i: number) => {
      const idx = (i + slides.length) % slides.length;
      slides[idx].scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
    };

    if (slides.length > 1) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const i = slides.indexOf(entry.target as HTMLElement);
              if (i >= 0) setActive(i);
            }
          });
        },
        { root: track, threshold: 0.6 },
      );
      slides.forEach((s) => io.observe(s));

      root.querySelector('[data-prev]')?.addEventListener('click', () => scrollToSlide(current - 1));
      root.querySelector('[data-next]')?.addEventListener('click', () => scrollToSlide(current + 1));
      dots.forEach((d, i) => d.addEventListener('click', () => scrollToSlide(i)));
    }

    // Lightbox
    const showLb = (i: number) => {
      if (!lbImg) return;
      lbIndex = (i + data.length) % data.length;
      lbImg.src = data[lbIndex].src;
      lbImg.alt = data[lbIndex].alt;
      if (lbCaption) lbCaption.textContent = data[lbIndex].caption;
      if (lbCounter) lbCounter.textContent = data.length > 1 ? `${lbIndex + 1} / ${data.length}` : '';
    };

    const closeLb = () => {
      if (dialog?.open) dialog.close();
      document.body.style.overflow = '';
    };

    if (dialog) {
      root.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((btn) => {
        btn.addEventListener('click', () => {
          showLb(Number(btn.dataset.open));
          if (typeof dialog.showModal === 'function') dialog.showModal();
          else dialog.setAttribute('open', '');
          document.body.style.overflow = 'hidden';
        });
      });

      root.querySelector('[data-close]')?.addEventListener('click', closeLb);
      root.querySelector('[data-lb-prev]')?.addEventListener('click', () => showLb(lbIndex - 1));
      root.querySelector('[data-lb-next]')?.addEventListener('click', () => showLb(lbIndex + 1));

      // Click on backdrop (the dialog element itself, outside the figure) closes it.
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) closeLb();
      });
      dialog.addEventListener('close', () => {
        document.body.style.overflow = '';
      });
      dialog.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') showLb(lbIndex - 1);
        else if (e.key === 'ArrowRight') showLb(lbIndex + 1);
      });
    }

    setActive(0);
  }

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(initCarousel);
</script>
