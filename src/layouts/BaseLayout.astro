---
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import ScrollToTop from '../components/site/ScrollToTop.astro';
import '../styles/global.css';
import { site } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title = site.title,
  description = site.description,
  image = '/images/og/og-default.png',
  type = 'website',
} = Astro.props;

const pageTitle = title === site.title ? site.title : `${title} | ${site.title}`;
const canonical = new URL(Astro.url.pathname, site.url).toString();
const ogImage = new URL(image, site.url).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050816" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${site.title} Blog`} href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="page-shell min-h-screen bg-slate-950 text-slate-100 antialiased">
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="relative isolate overflow-x-clip">
      <div class="pointer-events-none absolute inset-x-0 top-[-12rem] -z-10 h-[32rem] bg-[radial-gradient(circle_at_top,_rgba(56,189,248,0.14),_transparent_45%)]"></div>
      <Header />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>
    <ScrollToTop />
  </body>
</html>
